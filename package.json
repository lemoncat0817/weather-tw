{
  "name": "vue3-weather",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.3.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint . --fix",
    "test": "vitest run",
    "format": "prettier --write app/ server/ shared/",
    "build:cloudflare": "cross-env NITRO_PRESET=cloudflare-module nuxt build",
    "preview:cloudflare": "wrangler dev --cwd .output",
    "deploy:cloudflare": "pnpm build:cloudflare && wrangler deploy --cwd .output"
  },
  "dependencies": {
    "@vueuse/core": "^13.9.0",
    "@vueuse/nuxt": "^13.9.0",
    "echarts": "^6.1.0",
    "maplibre-gl": "^6.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.15.0",
    "@vue/test-utils": "^2.4.11",
    "cross-env": "^10.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^30.0.1",
    "nuxt": "^4.5.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.2.12",
    "wrangler": "^4.125.0"
  }
}
